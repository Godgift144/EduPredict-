# Copy to .env and adjust for your environment.

# One of: development | production | testing
FLASK_CONFIG=development

# Flask CLI application (lets bare `flask ...` commands work)
FLASK_APP=app

# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Database connection URL.
# SQLite (default, used for local development):
DATABASE_URL=sqlite:///data/app.db
# MySQL (production, as specified in the project documentation):
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/academic_prediction

# Max upload size in megabytes
MAX_UPLOAD_MB=5

# Port used by the Waitress/Gunicorn server
PORT=8000
